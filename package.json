{
  "name": "task_manager_api",
  "version": "1.0.0",
  "description": "Task manager API built with Node.js and Express",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "migrate": "dotenv -e .env -- npx tsx src/db/postgres/migrations/exec.ts",
    "migrate:test": "dotenv -e .env.test -- npx tsx src/db/postgres/migrations/exec.ts",
    "migrate:dev": "dotenv -e .env -- npx tsx src/db/postgres/migrations/exec.ts",
    "start:dev": "dotenv -e .env -- tsx --watch src/index.ts",
    "start": "dotenv -e .env -- tsx src/index.ts",
    "test": "dotenv -e .env.test -- vitest run --bail 1",
    "test:watch": "dotenv -e .env.test -- vitest --bail 1",
    "eslint:check": "eslint src --ext .ts",
    "prettier:check": "prettier --check src",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.4.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.4.0",
    "git-commit-msg-linter": "^5.0.8",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.22.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.20.0",
    "@types/validator": "^13.15.10",
    "@vitest/coverage-v8": "^4.1.8",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.0",
    "validator": "^13.15.35"
  }
}
