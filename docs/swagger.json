            }
          },
          "400": {
            "description": "Invalid params",
            "schema": {
              "$ref": "#/definitions/BadRequest"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/InternalServerError"
            }
          }
        }
      }
    },
    "/api/tasks/:taskId": {
      "get": {
        "summary": "Get a unique task",
        "tags": ["Tasks"],
        "parameters": [
          {
            "in": "path",
            "name": "taskId",
            "required": true,
            "type": "string",
            "description": "taskId of the task"
          }
        ],
        "responses": {
          "200": {
            "description": "Task returned when successfully",
            "schema": {
              "$ref": "#/definitions/Task"
            }
          },
          "400": {
            "description": "Invalid params",
            "schema": {
              "$ref": "#/definitions/BadRequest"
            }
          },
          "404": {
            "description": "Task not found",
            "schema": {
              "$ref": "#/definitions/NotFound"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/InternalServerError"
            }
          }
        }
      },
      "patch": {
        "summary": "Update a task",
        "tags": ["Tasks"],
        "parameters": [
          {
            "in": "path",
            "name": "taskId",
            "required": true,
            "type": "string",
            "description": "taskId of the task"
          },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "type": "object",
            "schema": {
              "$ref": "#/definitions/CreateTaskParams"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated task successfully",
            "schema": {
              "$ref": "#/definitions/Task"
            }
          },
          "400": {
            "description": "Invalid params",
            "schema": {
              "$ref": "#/definitions/BadRequest"
            }
          },
          "404": {
            "description": "Task not found",
            "schema": {
              "$ref": "#/definitions/NotFound"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/InternalServerError"
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a task",
        "tags": ["Tasks"],
        "parameters": [
          {
            "in": "path",
            "name": "taskId",
            "required": true,
            "type": "string",
            "description": "taskId of the task"
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted task successfully",
            "schema": {
              "$ref": "#/definitions/Task"
            }
          },

          "404": {
            "description": "Task not found",
            "schema": {
              "$ref": "#/definitions/NotFound"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/InternalServerError"
            }
          }
        }
      }
    },
    "/api/delete-many": {
      "delete": {
        "summary": "Delete all tasks",
        "tags": ["Tasks"],
        "responses": {
          "200": {
            "description": "all tasks deleted when successfully",
            "schema": {
              "$ref": "#/definitions/DeleteAllTasks"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/InternalServerError"
            }
          }
        }
      }
    }
